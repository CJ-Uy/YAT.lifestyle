{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yat-lifestyle-prod",
	"account_id": "8527ec1369d46f55304a6f59ab5356e4",
	"compatibility_date": "2026-09-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
      "binding": "DB",
      "database_name": "yat-lifestyle-prod-db",
      "database_id": "44991127-6383-4de9-8e0f-04a08bcd3adb"
		}
	],
	"r2_buckets": [
		{
      "bucket_name": "yat-lifestyle-prod-assets",
      "binding": "BUCKET"
		}
	]
}
