{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yat-lifestyle-prod",
	"account_id": "28aa5d214ab31fc266ffde3ba169711d",
  "vars": { "FORWARD_TO": "A66454385@gmail.com" },
  "routes": [
    { "pattern": "yatlifestyle.com", "custom_domain": true },
    { "pattern": "www.yatlifestyle.com", "custom_domain": true },
    { "pattern": "admin.yatlifestyle.com", "custom_domain": true }
  ],
	"compatibility_date": "2026-09-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
      "binding": "DB",
      "database_name": "yat-lifestyle-prod-db",
      "database_id": "7526a59a-6ad8-4ede-ba74-5ed18c51c47c"
		}
	],
	"r2_buckets": [
		{
      "bucket_name": "yat-lifestyle-prod-assets",
      "binding": "BUCKET"
		}
	],
  "ratelimits": [{
    "name": "NEWSLETTER_RATE_LIMITER",
    "namespace_id": "92624001",
    "simple": { "limit": 10, "period": 60 }
  }, {
    "name": "ELEMENT_RATE_LIMITER",
    "namespace_id": "92624002",
    "simple": { "limit": 300, "period": 60 }
  }, {
    "name": "CHECKOUT_RATE_LIMITER",
    "namespace_id": "92624003",
    "simple": { "limit": 10, "period": 60 }
  }],
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "vectorize": [{ "binding": "TAGS", "index_name": "element-tags" }]
}
